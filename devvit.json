{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "automodflow",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Config AutoMod like a pro",
        "description": "Open the visual AutoModerator rule editor.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/config-automod"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "moderator"
    },
    "redis": true
  },
  "dev": {
    "subreddit": "automodflow_dev"
  }
}
